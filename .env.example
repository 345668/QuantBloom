# === Local server (server.js) ===
# Port the API + UI are served on. Also the port Vite proxies /api to in dev.
API_PORT=3001

# === API Keys ===
# All optional — a missing key simply disables the panels that depend on it.
# The app runs with none set (Yahoo Finance needs no key and powers charts,
# quotes, screeners, backtests and the model lab).
# Finnhub (free tier - quotes, profile, analyst ratings, metrics, news,
# earnings & IPO calendars). Get a key at https://finnhub.io/dashboard.
# Note: /stock/price-target is premium; the app falls back to Yahoo for it.
FINNHUB_API_KEY=

# NewsAPI (free tier - business news)
NEWSAPI_KEY=

# FRED (Federal Reserve Economic Data - rates, VIX, oil, gold, macro)
FRED_API_KEY=

# Alpha Vantage (free tier - quote fallback)
ALPHA_VANTAGE_API_KEY=

# Marketaux (financial news with entity-level sentiment)
MARKETAUX_API_KEY=

# === Trading bot ===
# PAPER endpoint only. Pointing this at live trading places real orders.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Mistral — advisory review layer (can veto/shrink a trade, never originate one)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
