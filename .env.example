# === Local standalone server (server.js) ===
API_PORT=3001

# === Database (Neon PostgreSQL - required for full QuantBloom app) ===
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === Session secret (required for auth in full app) ===
SESSION_SECRET=your-session-secret-here

# === API Keys ===
# Finnhub (free tier - quotes, profile, analyst ratings, metrics, news,
# earnings & IPO calendars). Get a key at https://finnhub.io/dashboard.
# Note: /stock/price-target is premium; the app falls back to Yahoo for it.
FINNHUB_API_KEY=

# NewsAPI (free tier - business news)
NEWSAPI_KEY=

# FRED (Federal Reserve Economic Data - rates, VIX, oil, gold, macro)
FRED_API_KEY=

# Alpha Vantage (free tier - quote fallback)
ALPHA_VANTAGE_API_KEY=

# Marketaux (financial news with entity-level sentiment)
MARKETAUX_API_KEY=
